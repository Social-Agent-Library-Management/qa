{
  "id": "qaResultOutbound01",
  "name": "QA · 결과 출구",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "b2e1d3c5-0001-4000-8000-000000000001",
      "name": "QA 결과 수신",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "07ae9ab3-1d69-42f0-979c-01679e8c6bf7",
      "parameters": {
        "httpMethod": "POST",
        "path": "qa-result",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "b2e1d3c5-0002-4000-8000-000000000002",
      "name": "결과 답글",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [260, 0],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "id", "value": "={{ $json.body.reply_to.channel }}" },
        "messageType": "text",
        "text": "={{ $json.body.report.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "thread_ts": { "replyValues": { "thread_ts": "={{ $json.body.reply_to.thread_ts }}" } }
        }
      },
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "Slack · Library QA" } }
    },
    {
      "id": "b2e1d3c5-0003-4000-8000-000000000003",
      "name": "첨부 목록 펼치기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0],
      "parameters": {
        "jsCode": "const body = $('QA 결과 수신').first().json.body;\nreturn (body.report.attachments || []).map(a => ({ json: { ...a, channel: body.reply_to.channel, thread_ts: body.reply_to.thread_ts } }));"
      }
    },
    {
      "id": "b2e1d3c5-0004-4000-8000-000000000004",
      "name": "스크린샷 내려받기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 0],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } } }
      }
    },
    {
      "id": "b2e1d3c5-0005-4000-8000-000000000005",
      "name": "스크린샷 첨부",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1040, 0],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "binaryPropertyName": "data",
        "options": {
          "channelId": "={{ $('첨부 목록 펼치기').item.json.channel }}",
          "threadTs": "={{ $('첨부 목록 펼치기').item.json.thread_ts }}",
          "fileName": "={{ $('첨부 목록 펼치기').item.json.filename }}",
          "title": "={{ $('첨부 목록 펼치기').item.json.title }}"
        }
      },
      "credentials": { "slackApi": { "id": "SLACK_CREDENTIAL_ID", "name": "Slack · Library QA" } }
    }
  ],
  "connections": {
    "QA 결과 수신": { "main": [[{ "node": "결과 답글", "type": "main", "index": 0 }]] },
    "결과 답글": { "main": [[{ "node": "첨부 목록 펼치기", "type": "main", "index": 0 }]] },
    "첨부 목록 펼치기": { "main": [[{ "node": "스크린샷 내려받기", "type": "main", "index": 0 }]] },
    "스크린샷 내려받기": { "main": [[{ "node": "스크린샷 첨부", "type": "main", "index": 0 }]] }
  }
}
